# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth (configured in Supabase Auth provider settings)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Stripe
# Local mock only: stripe_dev_mock_secret_key
# Stripe test: sk_test_... | Production requires: sk_live_...
STRIPE_SECRET_KEY=stripe_dev_mock_secret_key
# Use the endpoint signing secret generated by Stripe CLI/Dashboard: whsec_...
STRIPE_WEBHOOK_SECRET=whsec_your-signing-secret
# Required for real test/live checkout. May be omitted only with stripe_dev_*.
STRIPE_MONTHLY_PRICE_ID=price_your-monthly-price
STRIPE_ANNUAL_PRICE_ID=price_your-annual-price

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seeded demo users' password (local integration tests only; set in .env.local)
SEED_DEMO_PASSWORD=
